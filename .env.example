# Sepolia Testnet RPC URL
# Get one from: https://www.alchemy.com/ or https://www.infura.io/
SEPOLIA_TESTNET_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Your wallet private key (WITHOUT 0x prefix)
# IMPORTANT: Never commit your real private key to git!
DEPLOYER=your_private_key_here

# Etherscan API Key for contract verification
# Get one from: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key_here

